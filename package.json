{
  "name": "charm-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "build": "node scripts/build-mcp-assets.mjs && tsc --noEmit && vite build && pnpm build:mcp-ui && pnpm build:server",
    "build:server": "node scripts/build-server.mjs",
    "start": "node --import tsx scripts/start-production.mjs",
    "setup:check": "node scripts/doctor.mjs",
    "test": "tsx --test tests/*.test.ts",
    "mcp:smoke": "node --import tsx scripts/mcp-smoke.mjs",
    "build:mcp-ui": "node scripts/build-mcp-assets.mjs && vite build --config vite.mcp.config.ts",
    "chatgpt:connect": "node scripts/chatgpt-connect.mjs",
    "chatgpt:ui-check": "node --import tsx scripts/chatgpt-browser-check.mjs",
    "chatgpt:3d-check": "node --import tsx scripts/widget-strict-csp-check.mjs --verify",
    "chatgpt:experience-check": "node --import tsx scripts/chatgpt-experience-check.mjs",
    "mcp:desktop-check": "node --import tsx scripts/mcp-desktop-check.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.1",
    "@react-three/rapier": "2.2.0",
    "@supabase/supabase-js": "2.58.0",
    "cookie-parser": "1.4.7",
    "dotenv": "17.2.3",
    "express": "5.1.0",
    "lucide-react": "0.468.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "three": "0.186.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@dimforge/rapier3d-compat": "0.19.2",
    "@types/cookie-parser": "1.4.9",
    "@types/express": "5.0.3",
    "@types/node": "24.5.2",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "5.0.4",
    "esbuild": "0.25.12",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.3.5"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.13"
  }
}
