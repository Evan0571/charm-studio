# LOOP teammate setup — copy to .env only when .env does not exist.
# Never commit .env or add VITE_ prefixes to server credentials.
# Full reference: docs/ENVIRONMENT.md. Restart the relevant process after edits.

# Ordinary website: pnpm dev / pnpm start
PORT=3000
HOST=127.0.0.1

# Website AI stylist (optional). Blank API key keeps manual editing available.
# ChatGPT's normal catalog -> preview workflow does NOT need this key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Storage: leave BOTH Supabase settings absent to use local SQLite.
# Default SQLite file: .data/charm-studio.sqlite; tables are created automatically.
# SQLITE_PATH=.data/charm-studio.sqlite
# To use Supabase, first execute supabase/schema.sql in YOUR project.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SECRET_KEY=your-server-only-secret-key

# Temporary ChatGPT connection: pnpm build && pnpm chatgpt:connect
# Install cloudflared separately on each computer. No Cloudflare account needed
# for the temporary Quick Tunnel. These overrides are optional.
# CHATGPT_PORT=3004
# CLOUDFLARED_BIN=/absolute/path/to/cloudflared
# Windows example: CLOUDFLARED_BIN=C:/tools/cloudflared.exe
# The helper supplies the public URL, signing key and secure cookie setting
# to its child. Do not copy a teammate's old temporary URL or signing key.

# Stable HTTPS deployment ONLY (not needed for ordinary local development).
# Set BOTH URL and a private random secret with >=32 characters.
# MCP_PUBLIC_URL=https://your-domain.example/mcp
# MCP_TOKEN_SECRET=replace-with-a-private-random-value-at-least-32-characters
# COOKIE_SECURE=true
# Keep .data/mcp-token-secret and .data/mcp-oauth.sqlite private and persistent.

# Vercel fixed-address deployment: docs/VERCEL_DEPLOY.md.
# Configure these in Vercel, not in a public client or committed .env:
# ENABLE_EXPERIMENTAL_COREPACK=1
# SUPABASE_URL and SUPABASE_SECRET_KEY (execute the complete schema first)
# MCP_TOKEN_SECRET (generate once; retain across deployments)
# COOKIE_SECURE=true
# MCP_PUBLIC_URL=https://your-production-domain/mcp (recommended explicit value)
# Vercel automatically uses shared Supabase OAuth and streamed MCP responses.
# For a local server using those same cloud paths, optionally set:
# MCP_OAUTH_STORAGE=supabase
# MCP_HTTP_STREAMING=true

# Amazon Pay US Sandbox (optional, single payment, no delivery).
# Register: https://payments.amazon.com/register?isSandbox=true&locale=en_US&source=APDW
# Use Integration Central in Sandbox View to obtain these values.
# AMAZON_PAY_MERCHANT_ID=
# AMAZON_PAY_STORE_ID=
# AMAZON_PAY_PUBLIC_KEY_ID=SANDBOX-your-public-key-id
# Keep the downloaded PEM outside the repository, or inside ignored .data/.
# Local example: AMAZON_PAY_PRIVATE_KEY_PATH=/absolute/path/to/your-private-key.pem
# Serverless alternative: AMAZON_PAY_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# Exact website origin used for the payment return. HTTPS or http://localhost only.
# AMAZON_PAY_BASE_URL=http://localhost:3000
